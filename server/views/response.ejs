<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
  <title>SpacedPeel Question</title>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
>
<style>
    button {
        margin-top: 2rem;
    }
</style>
</head>
<body>
    <main class="container">

    <div class="question-box">
  <h2><%= question.text %></h2>
  <form id="quizForm">
    <% question.answers.forEach(answer => { %>
      <div>
        <input 
          type="radio" 
          name="selectedAnswer" 
          value="<%= answer %>" 
          id="<%= answer %>"
          required
        >
        <label for="<%= answer %>"><%= answer %></label>
      </div>
    <% }) %>

    <!-- You can include the correct answer for demo or tracking purposes if needed -->
    <input type="hidden" name="correctAnswer" value="<%= question.correct %>">

    <button type="submit">Submit Answer</button>
  </form>
  </div>

  <!-- Optional: Show correct answer for demo purposes -->
  <p id="feedback"></p>
</main>

  <script defer>
const form = document.getElementById('quizForm');
const feedback = document.getElementById('feedback');

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const formData = new FormData(form);
  const data = Object.fromEntries(formData.entries());

  const res = await fetch('/response', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });

  const result = await res.json();
  console.log(result);
  
  feedback.textContent = result.message;
  feedback.style.color = result.isCorrect ? 'green' : 'red';
  form.reset()
});
</script>
</body>
</html>